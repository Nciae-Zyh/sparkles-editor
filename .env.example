# ============================================
# SparklesEditor 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# ── Cloudflare ──────────────────────────────
# 获取方式: https://dash.cloudflare.com/profile/api-tokens
# Account ID 在 Cloudflare Dashboard 右侧栏
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Google OAuth ─────────────────────────────
# 获取方式: https://console.cloud.google.com/apis/credentials
# 创建 OAuth 2.0 客户端 ID，授权回调 URI 填你的域名
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# 与 NUXT_GOOGLE_CLIENT_ID 相同，Nuxt public 变量会暴露到客户端
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── 小米 AI ──────────────────────────────────
# 获取方式: 小米 AI 开放平台
NUXT_XIAOMI_AI_API_KEY=

# ── Session (可选，生产环境务必修改) ──────────
# 随机生成一个强密钥: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_SECRET=your-secret-key-change-in-production
